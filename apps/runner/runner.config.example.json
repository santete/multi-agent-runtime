{
  "controlPlaneUrl": "http://127.0.0.1:7700",
  "name": "dev-laptop",
  "home": "./.runner",
  "pollIntervalMs": 2000,
  "heartbeatIntervalMs": 10000,
  "maxConcurrent": 2,
  "timeoutSeconds": 1800,
  "policyHook": true,
  "containerRuntime": "docker",
  "agents": {
    "shell": { "adapter": "generic-cli", "command": "bash", "args": ["-c", "{objective}"] },
    "claude-code": { "adapter": "claude-code", "skills": ["typescript", "backend", "frontend", "review"], "cost": "high" },
    "codex": { "adapter": "codex", "skills": ["typescript", "backend", "review"], "cost": "medium" },
    "antigravity": { "adapter": "antigravity", "executable": "C:/Users/<you>/AppData/Local/agy/bin/agy.exe", "unattended": false, "isolateConfig": true },
    "qoder": { "adapter": "qoder", "executable": "C:/Users/<you>/.qoder/bin/qodercli/qodercli.exe", "skills": ["typescript", "backend"], "cost": "medium" }
  }
}
